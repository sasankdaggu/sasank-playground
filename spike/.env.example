DATABASE_URL=postgresql+psycopg://wand:wand@localhost:5433/wand_spike
PLAYWRIGHT_HEADLESS=false
SAMPLES_PER_RETAILER=8

# --- ScraperAPI (Shopify D2C bulk ingestion) ---
# Sign up at https://www.scraperapi.com — free tier: 1k req/mo, paid from $49/mo (100k req)
# Routes all Shopify /products.json requests through ScraperAPI's proxy.
# Leave blank to fetch directly (fine for dev/testing).
SCRAPERAPI_KEY=

# --- Smartproxy (Indian marketplace scrapers: Nykaa, Tira, Purplle) ---
# Sign up at https://smartproxy.com — residential plans from ~$75/mo for 2GB
# Use country-targeted residential pool for India IPs.
# Username format: user-{YOUR_USER}-cc-in   (the "-cc-in" suffix targets India)
PROXY_URL=http://gate.smartproxy.com:10000
PROXY_USER=user-YOURUSER-cc-in
PROXY_PASS=

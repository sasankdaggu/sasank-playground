DATABASE_URL=postgresql+psycopg://wand:wand@localhost:5433/wand_spike
SECRET_KEY=change-me-in-production
DEBUG=false

# Auth
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
OTP_FROM_EMAIL=onboarding@resend.dev

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wand-images
R2_PUBLIC_URL=

# CORS (comma-separated for production)
CORS_ORIGINS=["http://localhost:3000"]

# --- Scraper: ScraperAPI (Shopify D2C bulk ingestion) ---
# https://www.scraperapi.com — $49/mo for 100k credits
# Leave blank to hit Shopify directly (fine for dev)
SCRAPERAPI_KEY=

# --- Scraper: Smartproxy residential (Indian marketplace scrapers) ---
# https://smartproxy.com — ~$75/mo for 2GB residential
# Username format: user-{YOUR_USER}-cc-in  (the -cc-in suffix = India country targeting)
PROXY_URL=http://gate.smartproxy.com:10000
PROXY_USER=user-YOURUSER-cc-in
PROXY_PASS=

# Scraper behaviour
SCRAPER_HEADLESS=true
SCRAPER_PAGE_LIMIT=50
